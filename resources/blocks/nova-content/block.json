{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "nova/content",
	"version": "1.0.0",
	"title": "NOVA Content",
	"category": "nova",
	"icon": "layout",
	"description": "Elastyczna sekcja treści oparta na wewnętrznych blokach.",
	"keywords": ["content", "sekcja", "nova"],
	"textdomain": "nova-wordpress",
	"supports": {
		"html": false,
		"anchor": true,
		"align": ["wide", "full"],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"attributes": {
		"width": {
			"type": "string",
			"default": "wide"
		}
	}
}
