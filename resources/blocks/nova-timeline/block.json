{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "nova/timeline",
	"title": "NOVA Timeline",
	"category": "nova",
	"attributes": {
		"eyebrow": {
			"type": "string",
			"default": ""
		},
		"heading": {
			"type": "string",
			"default": ""
		},
		"description": {
			"type": "string",
			"default": ""
		},
		"layout": {
			"type": "string",
			"default": "alternating"
		},
		"animate": {
			"type": "boolean",
			"default": true
		},
		"inactiveOpacity": {
			"type": "number",
			"default": 0.35
		},
		"items": {
			"type": "array",
			"default": [
				{
					"date": "",
					"title": "",
					"description": ""
				}
			]
		}
	},
	"render": "file:./render.php"
}
